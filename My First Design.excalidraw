    {
      "id": "ldoy2IZ-_Cm7-fC49RPhZ",
      "type": "text",
      "x": -1350.5045019759848,
      "y": 1078.5721985464033,
      "width": 728.9797973632812,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#4dabf7",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1w",
      "roundness": null,
      "seed": 1152939544,
      "version": 97,
      "versionNonce": 894347624,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776014689285,
      "link": null,
      "locked": false,
      "text": "Delivery. Worker writes the output to the output\nbucket, updates job to completed. Supabase Realtime\npushes the status change to the frontend\nautomatically. Frontend requests a download URL,\nFastAPI generates a pre-signed GET URL, file\ndownloads directly from Supabase Storage. If the\nworker fails 3 times, Celery writes a +1 refund row to\nthe ledger and the user gets their token back.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "0wVRqQTe-X8qie0RYN0hn",
      "originalText": "Delivery. Worker writes the output to the output bucket, updates job to completed. Supabase Realtime pushes the status change to the frontend automatically. Frontend requests a download URL, FastAPI generates a pre-signed GET URL, file downloads directly from Supabase Storage. If the worker fails 3 times, Celery writes a +1 refund row to the ledger and the user gets their token back.",
      "autoResize": true,
      "lineHeight": 1.25
    },
