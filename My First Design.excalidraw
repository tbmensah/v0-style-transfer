      "seed": 899417448,
      "version": 107,
      "versionNonce": 1532428824,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776014694184,
      "link": null,
      "locked": false,
      "text": "Celery worker picks up the task, reads the\nmetadata from Postgres and the file from the input\nbucket, runs your Python processing code, updates\nthe job status to processing in the DB.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "fGPZgZEHSS4gKkUoZk_79",
      "originalText": "Celery worker picks up the task, reads the metadata from Postgres and the file from the input bucket, runs your Python processing code, updates the job status to processing in the DB.",
      "autoResize": true,
      "lineHeight": 1.25
    },
