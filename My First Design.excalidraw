      "isDeleted": false,
      "boundElements": null,
      "updated": 1776014671622,
      "link": null,
      "locked": false,
      "text": "Token Purchase.\n User pays via Stripe Checkout. Stripe fires a\nwebhook to FastAPI which verifies the signature and\nwrites a +N row to the token_ledger table in\nSupabase",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "mspCNSYdIufeUJVh0mqpk",
      "originalText": "Token Purchase.\n User pays via Stripe Checkout. Stripe fires a webhook to FastAPI which verifies the signature and writes a +N row to the token_ledger table in Supabase",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YN0unbQIslv-KR-P4AVvK",
      "type": "rectangle",
      "x": -1455.2138299910443,
      "y": -45.197701804446524,
      "width": 690.5566086170879,
      "height": 350.9674862653801,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1h",
      "roundness": {
        "type": 3
      },
